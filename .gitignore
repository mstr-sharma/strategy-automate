.DS_Store
*.pyc
__pycache__/

# Local assistant/runtime state
.claude/

# Optional generated API cache; refresh with:
# python3 skills/build-mosaic-model/scripts/build_mosaic.py openapi-summary --out openapi.yaml
/openapi.yaml
/openapi.yml
/openapi.json

# Local secrets and transient logs
.env
.env.*
!.env.example
*.log

# Operator-local credential notes (never commit)
ignore/

# captures/ READMEs (dated transcripts) are tracked institutional memory;
# raw tenant payloads and run scripts dumped next to them stay local
# (scripts embed tenant object IDs; generalized versions belong under skills/)
captures/**/*.json
captures/**/*.ndjson
captures/**/*.har
captures/**/*.csv
captures/**/*.parquet
captures/**/*.py

# Tool caches and virtualenvs
.venv/
.pytest_cache/
.ruff_cache/

# Backups, keys and certificates (history bundles belong under ignore/ only)
*.bundle
*.pem
*.key
*.p12

# Script outputs that carry recipient names, owners or tenant URLs
library_publications*.csv
library_publications*.json
*.replicate_report.csv
*.by_recipient.csv
*.errors.csv
.coverage
.coverage.*
htmlcov/
.mypy_cache/
