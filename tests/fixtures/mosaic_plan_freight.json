    "format": "integer"
   }
  ],
  "derived": [
   {
    "name": "On Time Delivery Rate",
    "description": "Share of deliveries made on time.",
    "formula": "{On Time Deliveries} / {Deliveries}",
    "format": "percent"
   },
   {
    "name": "Late Delivery Rate",
    "description": "Share of deliveries made late.",
    "formula": "{Late Deliveries} / {Deliveries}",
    "format": "percent"
   },
   {
    "name": "Damage Claim Rate",
    "description": "Damage claims per delivery.",
    "formula": "{Damage Claims} / {Deliveries}",
    "format": "percent"
   },
   {
    "name": "Attempts per Delivery",
    "description": "Average delivery attempts per delivery.",
    "formula": "{Delivery Attempts} / {Deliveries}",
    "format": "fixed2"
   },
   {
    "name": "Delivery Timing Gap",
    "description": "Deliveries minus on-time and late deliveries; should read 0.",
    "formula": "{Deliveries} - {On Time Deliveries} - {Late Deliveries}",
    "format": "integer"
   },
   {
    "name": "Freight Cost per Pound",
    "description": "Invoiced freight per pound shipped.",
    "formula": "{Invoiced Amount} / {Weight Lbs}",
    "format": "currency"
   },
   {
    "name": "Freight Cost per Mile",
    "description": "Invoiced freight per mile.",
    "formula": "{Invoiced Amount} / {Distance Miles}",
    "format": "currency"
   },
   {
    "name": "Freight Cost Rate",
    "description": "Freight cost as share of shipment value.",
    "formula": "{Invoiced Amount} / {Shipment Amount}",
    "format": "percent"
   },
   {
    "name": "Overbilled Rate",
    "description": "Overbilled dollars as share of invoiced freight.",
    "formula": "{Overbilled Amount} / {Invoiced Amount}",
    "format": "percent"
   },
   {
    "name": "Invoice Reconciliation Gap",
    "description": "Invoiced amount less linehaul, fuel and accessorials; should read 0.",
    "formula": "{Invoiced Amount} - {Linehaul Charges} - {Fuel Surcharge} - {Accessorial Charges}",
    "format": "currency"
   },
   {
    "name": "Accessorial Share",
    "description": "Accessorials as share of invoiced freight.",
    "formula": "{Accessorial Charges} / {Invoiced Amount}",
    "format": "percent"
   },
   {
    "name": "Damage Claim Cost per Delivery",
    "description": "Average damage claim dollars per delivery.",
    "formula": "{Damage Claim Amount} / {Deliveries}",
    "format": "currency"
   }
  ],
